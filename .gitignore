desktop.ini
Thumbs.db

# R
.Rhistory
.RData

# Python
__pycache__/
*.pyc
*.pyo
.env
*.egg-info/

# Per-machine virtualenv (run-from-source on machines without Anaconda)
.venv/
venv/

# Validation: generated stream inventory (per-run, machine-specific)
validation/stream_inventory.json

# Machine-local launcher pointing at .venv (see "Avvia BiHome (da sorgente).bat" for the committed one)
Avvia BiHome (venv).bat

# Credenziali WiFi Arduino — mai in repo
all_sensors/**/secrets.h

# CSV generati (riproducibili dallo script import pyxdf.py)
data/csv_export/

# Viewer recordings (XDF files, potentially large)
Viewer/recordings/*.xdf

# Viewer diagnostics
Viewer/diag/

# Per-user persisted state
wizard_defaults.json

# PyInstaller build output (regenerate with: python build_exe.py)
build/
dist/

# Claude Code state — per-user, per-machine. Whole .claude/ folder
# is local: permissions, scheduled tasks, worktrees, settings.
.claude/

# PyInstaller .spec — regenerated each build, contains absolute paths
BiHome Wearable.spec

# Slide deck (large binary, iterated frequently — keep out of git history)
BiHome_Wearable_HTI.pptx

# Ad-hoc diagnostic logs at repo root
*.log
_scan_bf.log

# LabRecorder binaries (too large for git, download separately)
LabRecorder/*.exe
LabRecorder/*.dll
LabRecorder/*.lib
LabRecorder/iconengines/
LabRecorder/imageformats/
LabRecorder/networkinformation/
LabRecorder/platforms/
LabRecorder/styles/
LabRecorder/tls/
